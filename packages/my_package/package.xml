<?xml version="1.0"?>
<package format="2">
  <name>my_package</name>
  <version>0.0.1</version>
  <description>
    Duckietown traffic-light supervisor and helper utilities
    (lane-follow + object detection integration).
  </description>


  <maintainer email="ypuyam@purdue.edu">Yuvraj Puyam</maintainer>

  <!-- Pick any OSI-approved license you like -->
  <license>MIT</license>

  <!-- catkin build tool -->
  <buildtool_depend>catkin</buildtool_depend>


  <build_depend>rospy</build_depend>
  <build_depend>duckietown_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- For Duckietown DTROS base class, if you later subclass DTROS -->
  <exec_depend>duckietown</exec_depend>

  <export>
    <!-- nothing special to export -->
  </export>
</package>
